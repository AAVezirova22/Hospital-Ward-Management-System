# Local demo only. Choose new passwords before first startup.
DATABASE_PASSWORD=test
BOOTSTRAP_PASSWORD=ChooseALocalPassword123!
DEMO_SEED=true
# Enables public role-based entry and destructive reset. Synthetic databases only.
DEMO_MODE=true
PUBLIC_APP_URL=http://localhost:8088
RESEND_API_KEY=
EMAIL_FROM=Medcore <onboarding@resend.dev>
REGISTRATION_ENABLED=true
# Keep disabled until a verified sender and assigned-team email addresses are configured.
DISCHARGE_REMINDERS_ENABLED=false
DISCHARGE_REMINDER_WINDOWS=7,3,1
DISCHARGE_REMINDER_POLL_INTERVAL_MS=300000
DISCHARGE_REMINDER_RETRY_DELAY_MS=3600000
DISCHARGE_REMINDER_SENDING_LEASE_MS=900000
DISCHARGE_REMINDER_MAX_ATTEMPTS=5
DISCHARGE_REMINDER_OUTCOMES_LIMIT=50
# Browser push stays unavailable until both VAPID keys are configured.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.invalid
TASK_REMINDERS_ENABLED=false
TASK_REMINDER_POLL_INTERVAL_MS=60000
# HTTP localhost only. Use true behind HTTPS in a deployed environment.
COOKIE_SECURE=false
AI_MODE=local
AI_URL=
AI_API_KEY=
AI_MODEL=
# Google AI Studio: set AI_MODE=external, then supply your own key.
# AI_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_MODEL=gemini-3.5-flash-lite

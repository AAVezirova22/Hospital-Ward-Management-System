new file mode 100644
index 0000000..580b925
--- /dev/null
+++ b/frontend/src/landing/phone-scene.css
@@ -0,0 +1,507 @@
+.mc-phone-story.mc-messages {
+  display: block;
+  position: relative;
+  min-height: 215dvh;
+  padding: 0;
+}
+.mc-phone-sticky {
+  position: sticky;
+  top: 0;
+  min-height: 100dvh;
+  display: grid;
+  align-items: center;
+  overflow: clip;
+  padding-block: 92px 48px;
+}
+.mc-phone-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1.18fr) minmax(330px, 0.72fr);
+  align-items: center;
+  gap: clamp(48px, 7vw, 118px);
+}
+.mc-phone-stage {
+  position: relative;
+  min-height: clamp(590px, 76dvh, 760px);
+  perspective: 1700px;
+  transform-style: preserve-3d;
+  isolation: isolate;
+}
+.mc-phone-aura {
+  position: absolute;
+  left: 48%;
+  top: 46%;
+  width: min(46vw, 660px);
+  aspect-ratio: 1;
+  border-radius: 50%;
+  transform: translate(-50%, -50%);
+  background:
+    radial-gradient(
+      circle at 46% 44%,
+      color-mix(in srgb, var(--mc-green) 30%, transparent) 0,
+      transparent 52%
+    ),
+    radial-gradient(
+      circle at 58% 58%,
+      color-mix(in srgb, var(--mc-soft) 18%, transparent) 0,
+      transparent 68%
+    );
+  opacity: 0.72;
+  pointer-events: none;
+}
+.mc-phone-workspace-anchor {
+  position: absolute;
+  left: 51%;
+  top: 50%;
+  width: min(46vw, 650px);
+  transform: translate(-50%, -50%);
+  z-index: 1;
+}
+.mc-phone-workspace {
+  border-radius: 30px;
+  padding: 8px;
+  background: color-mix(in srgb, var(--mc-ink) 7%, var(--mc-bg));
+  box-shadow:
+    0 35px 90px color-mix(in srgb, var(--mc-green) 16%, transparent),
+    inset 0 1px 0 color-mix(in srgb, var(--mc-bg) 88%, transparent);
+  transform-origin: 55% 50%;
+  will-change: transform, opacity;
+}
+.mc-phone-workspace-window {
+  overflow: hidden;
+  border-radius: 23px;
+  background: var(--mc-card);
+  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--mc-bg) 55%, transparent);
+}
+.mc-phone-workspace-window header {
+  min-height: 43px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 18px;
+  padding: 0 16px;
+  color: var(--mc-text);
+  font-size: 0.62rem;
+  letter-spacing: 0.015em;
+}
+.mc-phone-workspace-window header span:last-child {
+  color: var(--mc-ink);
+}
+.mc-phone-workspace-window img {
+  display: block;
+  width: 100%;
+  height: min(55dvh, 520px);
+  object-fit: cover;
+  object-position: top;
+}
+.mc-phone-anchor {
+  position: absolute;
+  left: 47%;
+  top: 49%;
+  width: clamp(250px, 22vw, 326px);
+  aspect-ratio: 0.49;
+  transform: translate(-50%, -50%);
+  z-index: 3;
+}
+.mc-phone-device {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  transform-style: preserve-3d;
+  transform-origin: 50% 50%;
+  will-change: transform;
+}
+.mc-phone-shell {
+  position: absolute;
+  inset: 0;
+  border-radius: clamp(42px, 4vw, 56px);
+  padding: 7px;
+  background:
+    linear-gradient(
+      105deg,
+      color-mix(in srgb, var(--mc-bg) 82%, #ffffff) 0%,
+      color-mix(in srgb, var(--mc-green) 28%, var(--mc-bg)) 19%,
+      color-mix(in srgb, var(--mc-ink) 32%, var(--mc-bg)) 48%,
+      color-mix(in srgb, var(--mc-green) 18%, var(--mc-bg)) 76%,
+      color-mix(in srgb, var(--mc-bg) 82%, #ffffff) 100%
+    );
+  box-shadow:
+    0 46px 95px color-mix(in srgb, var(--mc-green) 22%, transparent),
+    0 14px 28px color-mix(in srgb, var(--mc-ink) 10%, transparent),
+    inset 0 1px 1px color-mix(in srgb, #ffffff 52%, transparent),
+    inset 0 -1px 1px color-mix(in srgb, var(--mc-ink) 16%, transparent);
+}
+.mc-phone-shell::before {
+  content: "";
+  position: absolute;
+  inset: 7px;
+  border-radius: calc(clamp(42px, 4vw, 56px) - 7px);
+  pointer-events: none;
+  box-shadow:
+    inset 1px 0 0 color-mix(in srgb, #ffffff 18%, transparent),
+    inset -1px 0 0 color-mix(in srgb, var(--mc-ink) 18%, transparent);
+}
+.mc-phone-face {
+  position: relative;
+  height: 100%;
+  overflow: hidden;
+  border-radius: calc(clamp(42px, 4vw, 56px) - 7px);
+  background: var(--mc-card);
+  box-shadow:
+    inset 0 0 0 1px color-mix(in srgb, var(--mc-ink) 8%, transparent),
+    inset 0 1px 2px color-mix(in srgb, #ffffff 14%, transparent);
+}
+.mc-phone-face::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 8;
+  pointer-events: none;
+  background: linear-gradient(
+    118deg,
+    color-mix(in srgb, #ffffff 12%, transparent),
+    transparent 22% 72%,
+    color-mix(in srgb, var(--mc-green) 8%, transparent)
+  );
+  mix-blend-mode: screen;
+}
+.mc-phone-side {
+  position: absolute;
+  width: 3px;
+  border-radius: 8px;
+  background: color-mix(in srgb, var(--mc-ink) 32%, var(--mc-bg));
+  box-shadow: inset 1px 0 0 color-mix(in srgb, #ffffff 26%, transparent);
+}
+.mc-phone-side.is-left-top {
+  left: -2px;
+  top: 22%;
+  height: 10%;
+}
+.mc-phone-side.is-left-bottom {
+  left: -2px;
+  top: 35%;
+  height: 17%;
+}
+.mc-phone-side.is-right {
+  right: -2px;
+  top: 29%;
+  height: 19%;
+}
+.mc-phone-status {
+  position: relative;
+  z-index: 4;
+  height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 19px;
+  color: var(--mc-ink);
+  font-size: 0.58rem;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+}
+.mc-phone-status-meta {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  font-size: 0.48rem;
+  letter-spacing: 0.02em;
+}
+.mc-phone-battery {
+  width: 17px;
+  height: 8px;
+  border: 1px solid color-mix(in srgb, var(--mc-ink) 68%, transparent);
+  border-radius: 2px;
+  padding: 1px;
+}
+.mc-phone-battery::before {
+  content: "";
+  display: block;
+  width: 72%;
+  height: 100%;
+  border-radius: 1px;
+  background: var(--mc-ink);
+}
+.mc-phone-island {
+  position: absolute;
+  z-index: 6;
+  top: 11px;
+  left: 50%;
+  width: 31%;
+  height: 24px;
+  transform: translateX(-50%);
+  border-radius: 999px;
+  background: color-mix(in srgb, var(--mc-ink) 88%, #07100d);
+  box-shadow: inset 0 1px 1px color-mix(in srgb, #ffffff 8%, transparent);
+}
+.mc-phone-conversation.mc-conversation {
+  margin: 0;
+  padding: 0 8px 8px;
+  height: calc(100% - 44px);
+  border-radius: 0;
+  background: transparent;
+  box-shadow: none;
+}
+.mc-phone-conversation.mc-conversation header {
+  position: relative;
+  z-index: 3;
+  min-height: 66px;
+  padding: 10px 10px 12px;
+  border-radius: 18px 18px 0 0;
+  background: color-mix(in srgb, var(--mc-card) 94%, transparent);
+  border-bottom: 1px solid color-mix(in srgb, var(--mc-line) 65%, transparent);
+}
+.mc-phone-conversation .mc-chat-avatar {
+  width: 36px;
+  height: 36px;
+  border-radius: 12px;
+}
+.mc-phone-conversation .mc-message-thread {
+  min-height: 0;
+  height: calc(100% - 66px);
+  overflow: hidden;
+  padding: 14px 10px 18px;
+  gap: 11px;
+  border-radius: 0 0 22px 22px;
+  background:
+    radial-gradient(
+      circle at 75% 18%,
+      color-mix(in srgb, var(--mc-green) 8%, transparent),
+      transparent 34%
+    ),
+    var(--mc-card);
+}
+.mc-phone-conversation .mc-bubble {
+  max-width: 91%;
+  padding: 10px 13px;
+  font-size: clamp(0.65rem, 0.72vw, 0.75rem);
+  line-height: 1.48;

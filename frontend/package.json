{
  "name": "medcore-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "e2e": "playwright test",
    "format": "prettier --write app src e2e *.ts *.json",
    "format:check": "prettier --check app src e2e *.ts *.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.80.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.16.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.29",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
